{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "precios": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "modelo": {
            "type": "string",
            "description": "slug del modelo: \"honda-br-v\""
          },
          "version": {
            "type": "string",
            "description": "id de la versión dentro del modelo"
          },
          "precioListaUSD": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ],
            "description": "Precio de lista en dólares, sin decimales"
          },
          "rangoCostoMensual": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "1",
                  "2",
                  "3",
                  "4"
                ]
              },
              {
                "type": "null"
              }
            ],
            "description": "Rango de costo mensual total (1–4) para filtrar por presupuesto; null = por calcular"
          },
          "fuente": {
            "type": "object",
            "properties": {
              "url": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "uri"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Enlace a la ficha o página oficial de donde sale el dato"
              },
              "fecha": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Día en que consultaste la fuente (AAAA-MM-DD)"
              },
              "pagina": {
                "description": "Página del PDF, si aplica",
                "anyOf": [
                  {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "nota": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "url",
              "fecha"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "modelo",
          "version",
          "precioListaUSD",
          "rangoCostoMensual",
          "fuente"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "precios"
  ],
  "additionalProperties": false
}
