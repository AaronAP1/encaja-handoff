{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "actualizado": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "marcas": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "marca": {
            "type": "string",
            "minLength": 1
          },
          "sitio": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "null"
              }
            ],
            "description": "Sitio oficial de la marca en Perú (null si no conviene enlazarlo)"
          },
          "fuente": {
            "type": "object",
            "properties": {
              "tipo": {
                "type": "string",
                "enum": [
                  "oficial",
                  "concesionario"
                ],
                "description": "De dónde sale la lista de modelos"
              },
              "fecha": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            },
            "required": [
              "tipo",
              "fecha"
            ],
            "additionalProperties": false
          },
          "modelos": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "nombre": {
                  "type": "string",
                  "minLength": 1
                },
                "tipo": {
                  "type": "string",
                  "enum": [
                    "SUV",
                    "Sedán",
                    "Hatchback",
                    "Minivan",
                    "Pick-up",
                    "Van",
                    "Otro"
                  ]
                },
                "url": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "uri"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "slugEncaja": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[a-z0-9-]+$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "nombre",
                "tipo",
                "url",
                "slugEncaja"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "marca",
          "sitio",
          "fuente",
          "modelos"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "actualizado",
    "marcas"
  ],
  "additionalProperties": false
}
